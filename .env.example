POSTGRES_USER=forge
POSTGRES_PASSWORD=forge
POSTGRES_DB=forge
DATABASE_URL=postgresql+asyncpg://forge:forge@postgres:5432/forge
REDIS_URL=redis://redis:6379/0
RABBITMQ_USER=forge
RABBITMQ_PASSWORD=forge
# guest is restricted to loopback by RabbitMQ, so containers use a non-loopback user.
RABBITMQ_URL=amqp://forge:forge@rabbitmq:5672/
CHECKOUT_API_URL=http://checkout-api:8000
INVENTORY_API_URL=http://inventory-api:8000
WORKER_API_URL=http://fulfillment-worker:8000
RABBITMQ_MGMT_URL=http://forge:forge@rabbitmq:15672
CHAOS_TOKEN=dev-token
REQUIRE_CHAOS_TOKEN=false
INJECTION_TTL_DEFAULT_S=300
ORCHESTRATOR_URL=http://orchestrator:8000
NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:8000
